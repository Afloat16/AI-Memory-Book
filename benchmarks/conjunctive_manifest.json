        "src",
        "--baseline-label",
        "score-aware-recall",
        "--candidate-label",
        "conjunctive-recall",
        "--corpora-json",
        "benchmarks/conjunctive_corpora.json",
        "--locomo-path",
        ".artifacts/data/locomo10.json",
        "--output",
        "benchmarks/results/conjunctive-preflight.json"
