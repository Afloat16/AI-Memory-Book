  "static_findings": [
    {
      "classification": "contract-preserving design",
      "finding": "Rust kernels preserve CPython Unicode code-point indexing including lone surrogates instead of converting inputs to UTF-8 strings.",
      "sources": [
        "rust/src/lib.rs",
        "rust/src/window.rs"
      ]
    },
    {
      "classification": "contract-preserving design",
      "finding": "The owned-window domain is bounded to unique query terms <=64, at most 40 positions per term and exactly representable integer-to-double sums; unsupported inputs are rejected before observable in-place sorting.",
      "sources": [
        "rust/src/window.rs",
        "rust/window_adapter.py"
      ]
    },
    {
      "classification": "contract-preserving design",
      "finding": "Metadata SQL callbacks are followed by dependency/container guards and exact Python continuations, preserving already-completed SQL and partial-update behavior instead of rerunning the method.",
      "sources": [
        "rust_metadata/src/lib.rs",
        "rust_metadata/adapter.py"
      ]
    },
    {
      "classification": "version-specific integration limit",
