  "script": "import ast,json,re,hashlib\nsource=configuration[\"auditor\"]\ntree=ast.parse(source)\nnamespace={\"re\":re}\nfor node in tree.body:\n    if isinstance(node,ast.FunctionDef) and node.name in (\"require\",\"timestamp_free\",\"actual_tests\"):\n        exec(compile(ast.Module(body=[node],type_ignores=[]),\"<auditor-functions>\",\"exec\"),namespace)\nnormal=namespace[\"timestamp_free\"]; inspect=namespace[\"actual_tests\"]\ntwo=[\n\"test_token_caps_keep_complete_payload_counts_and_source_spans (tests.test_native_backend.NativeMemoryBookEquivalenceTests.test_token_caps_keep_complete_payload_counts_and_source_spans) ... skipped 'Install .[tokens]'\",\n\"test_both_token_encoders_keep_exact_budgets_and_source_refs (tests.test_native_ranking_backend.NativeStoreEquivalenceTests.test_both_token_encoders_keep_exact_budgets_and_source_refs) ... skipped 'Install .[tokens]'\"]\nthird=\"test_available_shared_gil_subinterpreters_keep_main_module_working (tests.test_native_segmentation_backend.NativeSegmentationModuleStateTests.test_available_shared_gil_subinterpreters_keep_main_module_working) ... skipped '_xxsubinterpreters is not available in this Python build'\"\ndef fixture(lines):\n    return (\"\\n\".join(lines)+f\"\\nRan 144 tests in 1.234s\\n\\nOK (skipped={len(lines)})\\n\").encode()\nfor lines in (two,two+[third]):\n    assert inspect(fixture(lines))[\"skipped\"]==len(lines)\ninvalid=(two+[third.replace(\" is not available\",\" unavailable\")],two+[third.replace(\"keep_main_module_working\",\"unknown\")],two+[two[0]],[two[0],third],[])\nfor lines in invalid:\n    try: inspect(fixture(lines))\n    except AssertionError: pass\n    else: raise AssertionError(\"Malformed skip fixture was accepted\")\ncells=[]\nfor job_id,raw in configuration[\"logs\"].items():\n    text=normal(raw)\n    starts=list(re.finditer(r\"(?m)^##\\[group\\]Run [^\\n]*scripts/build_native_release_cell\\.py --expected-python (3\\.\\d+) --target[^\\n]*$\",text))\n    assert len(starts)==6\n    for match in starts:\n        end=re.search(r\"(?m)^##\\[group\\]Run \",text[match.end():])\n        block=text[match.start():match.end()+end.start() if end else len(text)]\n        result=inspect(block.encode())\n        cells.append({\"job_id\":job_id,\"python\":match[1],**result})\nprint(\"AUDITOR_PARSER_CHECK_JSON=\"+json.dumps({\"status\":\"passed\",\"auditor_sha256\":hashlib.sha256(source.encode()).hexdigest(),\"valid_fixtures\":2,\"rejected_fixtures\":len(invalid),\"actual_cells\":cells}),flush=True)\n"
