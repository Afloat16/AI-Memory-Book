  "preserved_findings": [
    {
      "id": "publisher-dead-leader-live-group",
      "severity_when_found": "blocking",
      "preserved_affected_draft": "aa65a40a1f8f334adb960a6c4bff634b34531cbc",
      "equivalent_later_draft": "486694bd7a4dfde4a72f2ca388c968a4e58fbd0f",
      "evidence_type": "Independent static counterexample, not an observed corpus interruption.",
      "finding": "The old draft killed the process group only while the worker leader poll was None. A reaped abnormal leader can leave its synchronous Git child alive; unconditional publisher handoff could race an orphan push.",
      "current_resolution": "23e9add7 requires normal zero exit and os.killpg(pgid,0) raising ProcessLookupError before handoff. Nonzero, timeout, launch failure and unknown/live group keep worker ownership. Best-effort group cleanup cannot grant ownership. The always step exits before public writes or Git operations while worker-owned.",
      "retained_cases": [
        "success",
        "timeout",
        "dead-leader-live-group",
        "zero-live-group",
        "unknown-group",
        "launch-failure"
      ],
      "status": "fixed-and-independently-checked-against-actual-artificial-CI"
    },
    {
      "id": "post-observer-payload-failure-prefix",
      "evidence_type": "Static failure-preservation boundary; artificial SQLite witness.",
      "finding": "Original recall/observer exception preservation did not encompass latency-field removal or payload fingerprint failure.",
      "current_resolution": "observe_payload encloses recall, latency removal and fingerprint in one failure path, attaches observer.report to the current failed row, fsyncs the failed ledger record and stops the cell. Both fingerprint ValueError and missing-latency KeyError keep the actual two native C spans, without exception values.",
      "status": "fixed-and-independently-checked"
    },
    {
      "id": "always-ledger-storage-identities",
      "evidence_type": "Static inspection of preservation return values.",
      "current_resolution": "pack_bytes raw/compressed hashes and byte lengths are retained in workflow-outcome.available_ledger_storage. Worker-owned quarantine remains artifact-only, with raw STATE ledgers and lifecycle/publisher/publication journals included by the workflow.",
      "status": "fixed-and-independently-checked"
    },
    {
      "id": "raw-lifo-topology-validation",
      "evidence_type": "Peer-provided static forged-raw counterexample; frozen observer producer already enforced a stack.",
      "finding": "The earlier raw auditor checked containment and direct-child sums but could accept two overlapping root spans or overlapping siblings.",
      "current_resolution": "108124 rebuilds active ancestors in call order. It rejects backward starts, roots or siblings overlapping an exited stack frame, and reopening a closed parent; declared parents disambiguate legal equal-clock ticks. The only changed top-level function from 23e is audit_observation.",
      "artificial_negative_cases": [
        "overlapping roots",
        "overlapping siblings",
        "nested interval incorrectly declared a root",
        "reopened parent at an equal clock tick"
      ],
      "artificial_positive_cases": [
        "adjacent roots",
        "zero-duration shared-tick nesting/siblings/next root",
        "adjacent siblings"
      ],
      "status": "fixed-and-independently-checked-against-actual-artificial-CI"
    }
  ],
  "reviewed_contracts": [
    {
      "area": "single publisher",
      "finding": "Only the designated controller or worker can publish according to a persistent role. Cell and worker intents precede calls. Expected remote head, ordinary non-force push and readback are mandatory; an ambiguous publication is recorded and not retried."
    },
    {
      "area": "no replay",
      "finding": "One immutable attempt namespace, run_attempt 1, exclusive worker and cell intent/ledger files and one new cohort DB prevent automatic rerun/resume. Failed query/cell/worker stops; prior completed diagnostic or LM claims/DBs are not reused."
    },
    {
      "area": "raw prefix",
      "finding": "Each query has a fsynced started record before observation and a completed/failed record after it. Cell output and ledger gzip identities are saved before the next cell. Available failed/open spans and full cells stay present; hard VM loss may still lose unpublished current-cell bytes, while the remote intent forbids replay."
    },
    {
      "area": "observer lifecycle",
      "finding": "A pre-existing profiler is rejected. sys.setprofile is installed only around recall and restored in finally. Native exact Connection/Cursor types, receiver/frame/owner/descriptor/method and strict LIFO identity govern pairing; fresh bound wrapper identity is retained as metadata. Callback failure, replacement, unmatched exits or an open stack invalidates the observation."
    },
    {
      "area": "classification",
      "finding": "Source filename/code/line/offset and upper caller classify fixed source sites without SQL, arguments, locals, row data or result content. Other native methods remain explicit. Unknown primary and disabled cache/coverage/optional paths retain raw data but make final classification acceptance false."
    },
    {
      "area": "frozen source and inputs",
      "finding": "require_binding is the first preflight/run/worker action and checks committed launch bytes. Separate correctness and measurement exports preserve full inventory checks. Guards before and after each cell verify all runtime files, original helper closure, scope/addenda/binding, preparation evidence, old corpus and references, interpreter/package/tokenizer-cache/boot environment."
    },
    {
      "area": "complete old payload audit",
      "finding": "One worker, one new MemoryBook per cohort, retained connection across all four fixed configurations, original seed/order/options and all 4732 calls. Every full non-timing payload and query order is checked against saved v0.3.2 C2 references. Missing/extra/duplicate/reordered rows or axes cannot be selected away."
    },
    {
      "area": "calibration boundary",
      "finding": "Exactly 1000 adjacent clock pairs and 128 observer-off then 128 observer-on invented calls are retained, with no best-of choice or subtraction from corpus measurements."
    },
    {
      "area": "workflow",
      "finding": "Sparse shallow checkout avoids history reports. Stdlib preflight precedes dependency/corpus preparation. Staging CI runs artificial tests only; attribution requires the unique registered ci branch and run attempt 1. Always artifacts include available public outputs, raw ledgers and ownership journals without the old corpus or database directories."
    }
